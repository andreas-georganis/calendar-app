@page "/register"
@using Calendar.Contracts
@using Calendar.Web.Client.Services

@inject IdentityClient IdentityClient

<h3>Register</h3>

<EditForm Model="User" OnValidSubmit="async () => await IdentityClient.Register(User!)">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <InputText id="email" class="form-control" Value="@User!.Email" />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" type="password" class="form-control" Value="@User.Password" />
    </div>

    <button type="submit" class="btn btn-primary">Register</button>
</EditForm>

@code {
    
    private User? User { get; set; }
    
    protected override void OnInitialized() => User ??= new User();
}
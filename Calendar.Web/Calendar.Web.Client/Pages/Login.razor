@page "/login"
@using Calendar.Contracts
@using Calendar.Web.Client.Services

@inject IdentityClient IdentityClient

<h3>Login</h3>

<EditForm Model="User" OnValidSubmit="async () => await IdentityClient.Login(User!)">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <InputText id="email" class="form-control" Value="@User!.Email" />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" type="password" class="form-control" Value="@User.Password" />
    </div>

    <button type="submit" class="btn btn-primary">Login</button>
    <a href="/register">Register</a>
    
</EditForm>

@code {

    [SupplyParameterFromForm]
    private User? User { get; set; }
    
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }
    
    protected override void OnInitialized()
    {
        User ??= new ();
    }

}